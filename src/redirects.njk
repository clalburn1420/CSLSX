---
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "/{{ r.from }}/"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Moved — CSLSX</title>
  <meta name="robots" content="noindex">
  <meta http-equiv="refresh" content="0; url={{ r.to }}">
  <link rel="canonical" href="{{ site.url }}{{ r.to }}">
</head>
<body>
  <p>This page has moved to <a href="{{ r.to }}">{{ site.url }}{{ r.to }}</a>.</p>
</body>
</html>
